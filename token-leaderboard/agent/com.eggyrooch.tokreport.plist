<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchAgent：装在用户域，才能读到该用户的 ~/.claude、~/.codex 等日志。
     每天 19:00 跑一次；加载时也跑一次。日志见 /tmp/tokreport.* 。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.eggyrooch.tokreport</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/usr/local/bin/tokreport.py</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>19</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/tokreport.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/tokreport.err.log</string>
</dict>
</plist>
